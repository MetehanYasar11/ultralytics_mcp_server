  "description": "🚀 Ultralytics MCP Server - AI/ML Model Context Protocol server for YOLO object detection and computer vision tasks",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "curl http://localhost:8092/health",
